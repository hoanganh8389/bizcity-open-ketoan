{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_vn_profile/1.0.0",
  "title": "bizcity_vn_profile@1",
  "description": "Hồ sơ đơn vị GIẢ LẬP dùng để chọn rulepack khi chứng nhận (--certify, R-VNC-4 bước 1): loại pháp nhân, chế độ kế toán được cấu hình, ngày bắt đầu năm tài chính, ngày đánh giá (as_of = ngày giao dịch giả định). Không phải đơn vị thật.",
  "type": "object",
  "required": ["contract", "jurisdiction", "accounting_regime", "fiscal_year_start", "entity_type", "as_of"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "bizcity_vn_profile@1" },
    "name": { "type": "string" },
    "jurisdiction": { "const": "VN" },
    "accounting_regime": { "enum": ["vn-tt200-2014", "vn-tt99-2025", "vn-tt133-2016", "vn-tt152-2025", "unknown"], "description": "unknown = chưa cấu hình: mọi rulepack theo chế độ ra REVIEW_REQUIRED" },
    "fiscal_year_start": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "description": "MM-DD" },
    "entity_type": { "enum": ["enterprise", "sme", "micro", "household", "public"] },
    "as_of": { "anyOf": [ { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" } ], "description": "null = hôm nay" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^C\\d{2}$" }, "description": "Giới hạn catalog; bỏ trống = mọi rulepack đang có" }
  }
}
