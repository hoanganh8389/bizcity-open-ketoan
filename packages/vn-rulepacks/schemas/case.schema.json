{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_vn_case/1.1.0",
  "title": "bizcity_vn_case@1",
  "description": "Một ca kiểm chuẩn Việt Nam (PHASE-020). Ca khai: phạm vi áp dụng, căn cứ, cách chứng minh (verified_by trỏ check SC-*/DG-* hoặc test có thật; hoặc fixture vàng), khoảng trống bằng chứng, trạng thái duyệt. expected_fixture KHÔNG chứa logic hạch toán do AI suy đoán: do người duyệt chốt và băm (R-VNC-3, R-VNC-6).",
  "type": "object",
  "required": ["contract", "id", "version", "rulepack", "title", "status", "priority", "applies_to", "legal_basis", "scenario", "on_missing_basis", "review", "golden"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "bizcity_vn_case@1" },
    "id": { "type": "string", "pattern": "^vn\\.[a-z][a-z0-9-]*(\\.[a-z0-9_]+)+\\.\\d{3}$", "description": "vn.<rulepack>.<nhóm>.<slug>.<nnn>; ổn định sau phát hành, đổi nội dung = tăng version" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
    "rulepack": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "spec_ref": { "type": "string", "description": "Mã trong đặc tả OKT-SPEC-VNCONF-001 §5, vd C01.3" },
    "title": { "type": "string", "minLength": 10, "maxLength": 200 },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "review_required", "approved", "deprecated"] },
    "priority": { "enum": ["P0", "P1"] },
    "applies_to": { "$ref": "#/$defs/applicability" },
    "legal_basis": { "type": "array", "items": { "$ref": "#/$defs/legalBasis" } },
    "scenario": {
      "type": "object", "required": ["kind", "verified_by", "assertions", "gap"], "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["static", "diagnostics", "runtime", "fixture"], "description": "static = check SC-*; diagnostics = DG-* trên CSDL; runtime = test qua cổng công khai; fixture = input/expected vàng chạy bằng runner" },
        "verified_by": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^((SC|DG)-[A-Z]+-\\d+|[a-z0-9-]+\\.test\\.ts)$" }, "description": "Bằng chứng ĐANG CÓ trong repo. Rỗng = NOT_TESTED" },
        "input_fixture": { "anyOf": [ { "type": "string", "pattern": "^fixtures/[a-z0-9_./-]+\\.json$" }, { "type": "null" } ] },
        "expected_fixture": { "anyOf": [ { "type": "string", "pattern": "^fixtures/[a-z0-9_./-]+\\.json$" }, { "type": "null" } ] },
        "assertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "gap": { "anyOf": [ { "type": "string", "minLength": 10 }, { "type": "null" } ], "description": "Khoảng trống so với yêu cầu: điều gì CHƯA chứng minh được bằng mã hiện có. null = không có khoảng trống" },
        "notes": { "type": "string" },
        "params": { "type": "object", "additionalProperties": { "anyOf": [ { "type": "string" }, { "type": "number" }, { "type": "boolean" } ] }, "description": "1.1.0 (2026-11-02): tham số của luật mà kiểm DG-* đọc từ ca (vd thời gian áp thuế suất giảm) — số liệu luật nằm ở dữ liệu rulepack, không viết cứng trong Kernel (R-VNC-10). Đổi tham số = đổi nội dung ca = tăng version; lượt duyệt tại đơn vị hết hiệu lực" }
      }
    },
    "on_missing_basis": { "const": "REVIEW_REQUIRED", "description": "Fail closed: thiếu căn cứ / mơ hồ thì REVIEW_REQUIRED, không đoán (R-VNC-3)" },
    "review": { "$ref": "#/$defs/review" },
    "golden": {
      "type": "object", "required": ["hash", "approved_at"], "additionalProperties": false,
      "properties": {
        "hash": { "anyOf": [ { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" } ], "description": "Băm expected_fixture do người duyệt chốt; sửa fixture ngoài quy trình thì lệch băm, SC-VNC-2 đỏ" },
        "approved_at": { "anyOf": [ { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" } ] }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateOrNull": { "anyOf": [ { "$ref": "#/$defs/date" }, { "type": "null" } ] },
    "applicability": {
      "type": "object", "required": ["entity_types", "fiscal_year_start_from", "transaction_date_from", "transaction_date_to"], "additionalProperties": false,
      "properties": {
        "entity_types": { "type": "array", "minItems": 1, "items": { "enum": ["enterprise", "sme", "micro", "household", "public", "any"] } },
        "business_types": { "type": "array", "items": { "type": "string" } },
        "fiscal_year_start_from": { "$ref": "#/$defs/dateOrNull" },
        "transaction_date_from": { "$ref": "#/$defs/dateOrNull" },
        "transaction_date_to": { "$ref": "#/$defs/dateOrNull" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "branch_scope": { "enum": ["tenant", "branch", "any"] }
      }
    },
    "legalBasis": {
      "type": "object", "required": ["source_id", "provision_ref", "review_status"], "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^vn\\.[a-z]+\\.[a-z0-9-]+$" },
        "provision_ref": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["pending", "reviewed"] },
        "note": { "type": "string" }
      }
    },
    "review": {
      "type": "object", "required": ["accounting_reviewer", "tax_reviewer", "approved_at", "notes"], "additionalProperties": false,
      "properties": {
        "accounting_reviewer": { "anyOf": [ { "type": "string", "minLength": 2 }, { "type": "null" } ] },
        "tax_reviewer": { "anyOf": [ { "type": "string", "minLength": 2 }, { "type": "null" } ] },
        "approved_at": { "$ref": "#/$defs/dateOrNull" },
        "notes": { "type": "string" }
      }
    }
  }
}
