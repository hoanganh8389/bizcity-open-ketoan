{
  "name": "@bizcity/module-sdk",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "SDK cho module Bizcity (ADR-0011 mức 1): mặt tiền DUY NHẤT module được import từ Bizcity — defineModule, defineAction, defineSubscriber, kiểu ctx, Errors, z, tiền. Không mở db, bảng Kernel, ledgerService, postDocumentIn, eventStore (API.md §4).",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "development": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bizcity/platform": "0.1.0",
    "@ketoan/contracts": "0.1.0",
    "kysely": "0.27.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.6.3"
  }
}
