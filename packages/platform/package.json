{
  "name": "@bizcity/platform",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "Platform của Bizcity Core: lỗi chuẩn, HTTP, quyền, bằng chứng, runtime action, sự kiện, số đo, kết nối CSDL, chứng từ dùng chung. Kernel và ứng dụng cùng dựa vào; Platform không biết Kernel (LAYOUT-1).",
  "type": "module",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ketoan/contracts": "0.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "fastify": "5.1.0",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "jose": "5.9.6",
    "kysely": "0.27.4",
    "pg": "8.13.1",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "typescript": "5.6.3"
  }
}
