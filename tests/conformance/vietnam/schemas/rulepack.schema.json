{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_vn_rulepack/1.0.0",
  "title": "bizcity_vn_rulepack@1",
  "description": "Một rulepack của bộ kiểm chuẩn Việt Nam (PHASE-020, R-VNC-2, R-VNC-3): nhóm ca kiểm cùng miền quy định, có phạm vi áp dụng, căn cứ pháp lý, trạng thái phê duyệt và bản phát hành bất biến. status = approved chỉ hợp lệ khi SC-VNC-2 đạt (căn cứ đã rà, hai người duyệt, golden hash).",
  "type": "object",
  "required": ["contract", "id", "version", "catalog_id", "title", "jurisdiction", "domain", "regime", "priority", "status", "applies_to", "legal_basis", "cases", "review", "release"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "bizcity_vn_rulepack@1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "description": "Tên thư mục rulepacks/<id>/; ổn định sau phát hành" },
    "version": { "$ref": "#/$defs/semver" },
    "catalog_id": { "type": "string", "pattern": "^C\\d{2}$", "description": "Mã trong catalog.json (C01…C08)" },
    "title": { "type": "string", "minLength": 5, "maxLength": 160 },
    "description": { "type": "string" },
    "jurisdiction": { "const": "VN" },
    "domain": { "enum": ["accounting", "tax", "invoice", "tax_admin", "security", "costing", "payroll", "reporting"] },
    "regime": { "enum": ["neutral", "vn-tt99-2025", "vn-tt133-2016"], "description": "neutral = không phụ thuộc chế độ kế toán" },
    "priority": { "enum": ["P0", "P1"] },
    "status": { "$ref": "#/$defs/status" },
    "applies_to": { "$ref": "#/$defs/applicability" },
    "legal_basis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legalBasis" } },
    "cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^cases/[a-z0-9_-]+\\.json$" } },
    "review": { "$ref": "#/$defs/review" },
    "release": {
      "type": "object", "required": ["rules_hash", "released_at", "changelog"], "additionalProperties": false,
      "properties": {
        "rules_hash": { "anyOf": [ { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" } ], "description": "Băm toàn bộ rulepack.json + cases/ + fixtures/ lúc phát hành; null khi chưa phát hành" },
        "released_at": { "$ref": "#/$defs/dateOrNull" },
        "changelog": { "type": "array", "items": { "type": "object", "required": ["version", "date", "note"], "additionalProperties": false, "properties": { "version": { "$ref": "#/$defs/semver" }, "date": { "$ref": "#/$defs/date" }, "note": { "type": "string", "minLength": 3 } } } }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateOrNull": { "anyOf": [ { "$ref": "#/$defs/date" }, { "type": "null" } ] },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
    "status": { "enum": ["draft", "review_required", "approved", "deprecated"] },
    "applicability": {
      "type": "object", "required": ["entity_types", "fiscal_year_start_from", "transaction_date_from", "transaction_date_to"], "additionalProperties": false,
      "properties": {
        "entity_types": { "type": "array", "minItems": 1, "items": { "enum": ["enterprise", "sme", "micro", "household", "public", "any"] } },
        "business_types": { "type": "array", "items": { "type": "string" } },
        "fiscal_year_start_from": { "$ref": "#/$defs/dateOrNull", "description": "Áp cho năm tài chính bắt đầu từ ngày này. null = mọi năm tài chính" },
        "transaction_date_from": { "$ref": "#/$defs/dateOrNull", "description": "Áp cho giao dịch / hoá đơn từ ngày này (miền thuế, hoá đơn)" },
        "transaction_date_to": { "$ref": "#/$defs/dateOrNull" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "branch_scope": { "enum": ["tenant", "branch", "any"] }
      }
    },
    "legalBasis": {
      "type": "object", "required": ["source_id", "provision_ref", "review_status"], "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^vn\\.[a-z]+\\.[a-z0-9-]+$", "description": "id trong registry/legal-sources.json" },
        "provision_ref": { "type": "string", "minLength": 1, "description": "Điều / khoản / điểm hoặc REVIEW_REQUIRED" },
        "review_status": { "enum": ["pending", "reviewed"] },
        "note": { "type": "string" }
      }
    },
    "review": {
      "type": "object", "required": ["accounting_reviewer", "tax_reviewer", "approved_at", "notes"], "additionalProperties": false,
      "properties": {
        "accounting_reviewer": { "anyOf": [ { "type": "string", "minLength": 2 }, { "type": "null" } ] },
        "tax_reviewer": { "anyOf": [ { "type": "string", "minLength": 2 }, { "type": "null" } ], "description": "Bắt buộc với domain tax / invoice / tax_admin / payroll" },
        "approved_at": { "$ref": "#/$defs/dateOrNull" },
        "notes": { "type": "string" }
      }
    }
  }
}
