{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_vn_legal_registry/1.0.0",
  "title": "bizcity_vn_legal_registry@1",
  "description": "Kho nguồn pháp lý của bộ kiểm chuẩn Việt Nam (PHASE-020, R-VNC-1). Mỗi nguồn: số hiệu, cơ quan ban hành, hiệu lực, điều khoản có hiệu lực riêng, nguồn chính thức, ảnh chụp có băm, trạng thái rà soát. Kho là DỮ LIỆU tra cứu, không phải ý kiến pháp lý; mọi mục review.status = pending đều chưa được dùng làm căn cứ cho rulepack approved.",
  "type": "object",
  "required": ["contract", "updated_at", "notice", "sources"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "bizcity_vn_legal_registry@1" },
    "updated_at": { "$ref": "#/$defs/date" },
    "notice": { "type": "string", "minLength": 20 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateOrNull": { "anyOf": [ { "$ref": "#/$defs/date" }, { "type": "null" } ] },
    "urlOrNull": { "anyOf": [ { "type": "string", "pattern": "^https://" }, { "type": "null" } ] },
    "reviewStatus": { "enum": ["pending", "reviewed", "rejected"] },
    "domain": { "enum": ["accounting", "tax", "invoice", "tax_admin", "standard", "other"], "description": "Kế toán, thuế, hoá đơn, quản lý thuế là các miền quy định KHÁC NHAU (R-VNC-5)" },
    "source": {
      "type": "object",
      "required": ["id", "kind", "domain", "number", "title", "issuer", "issued_on", "effective_from", "effective_to", "status", "official_url", "snapshot", "provisions", "review"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^vn\\.(law|decree|circular|resolution|decision|consolidated|guidance)\\.[a-z0-9]+(-[a-z0-9]+)*$", "description": "Ổn định, không đổi sau khi đã có rulepack trỏ tới" },
        "kind": { "enum": ["law", "decree", "circular", "resolution", "decision", "consolidated", "guidance"] },
        "domain": { "$ref": "#/$defs/domain" },
        "number": { "type": "string", "minLength": 3, "description": "Số hiệu như in trên văn bản, vd 99/2025/TT-BTC" },
        "title": { "type": "string", "minLength": 5 },
        "issuer": { "type": "string", "minLength": 2 },
        "issued_on": { "$ref": "#/$defs/dateOrNull" },
        "effective_from": { "$ref": "#/$defs/dateOrNull", "description": "Hiệu lực chung của văn bản. Hiệu lực theo điều khoản ghi ở provisions" },
        "effective_to": { "$ref": "#/$defs/dateOrNull" },
        "status": { "enum": ["in_force", "amended", "replaced", "expired", "pending_effect", "unverified"] },
        "applies_to": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "entity_types": { "type": "array", "items": { "type": "string" } },
            "fiscal_year_start_from": { "$ref": "#/$defs/dateOrNull", "description": "Áp dụng cho năm tài chính bắt đầu từ ngày này (vd TT99: 2026-01-01), KHÔNG phải cho mọi giao dịch từ ngày đó" },
            "note": { "type": "string" }
          }
        },
        "replaces": { "type": "array", "items": { "type": "string" } },
        "amended_by": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "official_url": { "$ref": "#/$defs/urlOrNull", "description": "Công báo, vanban.chinhphu.vn, vbpl.vn, mof.gov.vn. null = chưa có link chính thức, khi đó review.status phải là pending" },
        "secondary_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "description": "Nguồn thứ cấp chỉ để đọc nhanh, KHÔNG là căn cứ" },
        "snapshot": {
          "type": "object", "required": ["retrieved_at", "sha256", "consolidated_version"], "additionalProperties": false,
          "properties": {
            "retrieved_at": { "$ref": "#/$defs/dateOrNull" },
            "sha256": { "anyOf": [ { "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" } ] },
            "consolidated_version": { "anyOf": [ { "type": "string" }, { "type": "null" } ], "description": "Văn bản hợp nhất đã dùng (vd 41/VBHN-VPQH)" },
            "path": { "type": "string", "description": "Đường dẫn ảnh chụp trong kho lưu, nếu có" }
          }
        },
        "provisions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["ref", "summary", "review_status"], "additionalProperties": false,
            "properties": {
              "ref": { "type": "string", "minLength": 1, "description": "Điều / khoản / điểm, vd Điều 27 khoản 1. REVIEW_REQUIRED khi chưa đọc được văn bản gốc" },
              "summary": { "type": "string", "minLength": 5 },
              "effective_from": { "$ref": "#/$defs/dateOrNull" },
              "effective_to": { "$ref": "#/$defs/dateOrNull" },
              "review_status": { "$ref": "#/$defs/reviewStatus" }
            }
          }
        },
        "review": {
          "type": "object", "required": ["status", "reviewed_at", "reviewed_by", "notes"], "additionalProperties": false,
          "properties": {
            "status": { "$ref": "#/$defs/reviewStatus" },
            "reviewed_at": { "$ref": "#/$defs/dateOrNull" },
            "reviewed_by": { "anyOf": [ { "type": "string", "minLength": 2 }, { "type": "null" } ], "description": "Người có trách nhiệm (kế toán trưởng / chuyên gia thuế / luật sư). Không ghi tên agent / model" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
