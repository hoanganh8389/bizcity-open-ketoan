{
  "contract": "bizcity_module@1",
  "id": "bizcity.pos",
  "key": "pos",
  "kind": "module",
  "version": "0.4.1",
  "label": "Máy bán POS",
  "description": "Phía máy chủ của máy bán POS (hợp đồng /pos/*): khởi động màn bán, cấp số phiếu, nhận đơn bán tại quầy và nộp chứng từ sale vào sổ qua cửa nạp (kế hoạch module POS).",
  "owners": [
    "@hoanganh8389"
  ],
  "standard": "^1.0",
  "requires": {
    "capabilities": [
      "ledger.submit",
      "data.tenant-tx",
      "data.read-views",
      "data.migrations.module",
      "actions.runtime",
      "actions.idempotency",
      "evidence.receipt",
      "ledger.cancel",
      "events.outbox",
      "settings.registry",
      "actions.call",
      "events.subscribe",
      "documents.versions",
      "documents.links"
    ]
  },
  "permissions": [
    {
      "key": "pos:sell",
      "label": "Bán hàng trên máy POS: khởi động màn bán, xin số phiếu, gửi đơn, xem / tra đơn, tìm khách",
      "risk": "low"
    },
    {
      "key": "pos:return",
      "label": "Trả hàng / đổi hàng trên máy POS (phiếu trả nối đơn gốc)",
      "risk": "low"
    },
    {
      "key": "pos:cancel",
      "label": "Huỷ đơn máy POS đang chờ thanh toán",
      "risk": "low"
    },
    {
      "key": "pos:report",
      "label": "Xem quản trị bán lẻ máy POS: đơn, phiếu trả, sổ ca, tổng quan, cài đặt bán hàng của mọi chi nhánh (kế toán, quản lý)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant",
        "viewer"
      ],
      "risk": "low"
    },
    {
      "key": "pos:promo-approve",
      "label": "Duyệt / từ chối chương trình khuyến mại (BH18) — người lập không tự duyệt; duyệt xong màn phát hành vào sổ chính sách",
      "roles": [
        "owner",
        "chief_accountant"
      ],
      "risk": "high"
    },
    {
      "key": "pos:return-approve",
      "label": "Duyệt / từ chối yêu cầu trả hàng quá hạn của máy bán (NT-BH-030) — người gửi không tự duyệt; duyệt xong máy bán mới lập phiếu trả đúng nội dung đã duyệt",
      "roles": [
        "owner",
        "chief_accountant"
      ],
      "risk": "high"
    },
    {
      "key": "pos:kenh-ban-lap",
      "label": "Kênh bán hàng — thêm kênh (NT-BH-031)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant"
      ],
      "risk": "low"
    },
    {
      "key": "pos:kenh-ban-sua",
      "label": "Kênh bán hàng — sửa tên / loại online-offline / thứ tự, dùng lại kênh đã ngừng (NT-BH-031)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant"
      ],
      "risk": "low"
    },
    {
      "key": "pos:kenh-ban-xoa",
      "label": "Kênh bán hàng — ngừng dùng kênh (thay cho xoá: kênh đã dùng không xoá, ECP-13; NT-BH-031)",
      "roles": [
        "owner",
        "chief_accountant"
      ],
      "risk": "low"
    }
  ],
  "data": {
    "schema": "mod_pos",
    "tables": [
      "orders",
      "order_lines",
      "returns",
      "return_lines",
      "code_counters",
      "shifts",
      "promo_drafts",
      "promo_draft_log",
      "promo_quotas",
      "promo_uses",
      "voucher_uses",
      "code_reservations",
      "return_approvals",
      "return_approval_log",
      "sale_channels"
    ],
    "reads": [
      "bizcity_read.branches",
      "bizcity_read.products",
      "bizcity_read.tax_codes",
      "bizcity_read.payment_methods",
      "bizcity_read.partners",
      "bizcity_read.branch_prices",
      "bizcity_read.stock_on_hand",
      "bizcity_read.warehouses",
      "bizcity_read.item_kinds"
    ]
  },
  "actions": [
    "pos.bootstrap.get",
    "pos.sequence.reserve",
    "pos.order.create",
    "pos.order.get",
    "pos.order.lookup",
    "pos.order.lines",
    "pos.order.cancel",
    "pos.order.returnable",
    "pos.return.create",
    "pos.return.list",
    "pos.exchange.create",
    "pos.customer.search",
    "pos.customer.lookup",
    "pos.customer.orders",
    "pos.catalog.snapshot",
    "pos.catalog.search",
    "pos.catalog.barcode",
    "pos.stock.get",
    "pos.shift.current",
    "pos.shift.open",
    "pos.shift.close",
    "pos.report.orders",
    "pos.report.dashboard",
    "pos.admin.orders",
    "pos.admin.returns",
    "pos.admin.shifts",
    "pos.admin.dashboard",
    "pos.admin.settings",
    "pos.admin.shift-journal",
    "pos.order.qr-confirm",
    "pos.order.qr-renew",
    "pos.order.invoice-buyer",
    "pos.order.move-to-z",
    "pos.stock.all",
    "pos.promo.draft.list",
    "pos.promo.draft.get",
    "pos.promo.draft.create",
    "pos.promo.draft.update",
    "pos.promo.draft.overlaps",
    "pos.promo.draft.approve",
    "pos.promo.draft.published",
    "pos.promo.draft.reject",
    "pos.promo.draft.import",
    "pos.promo.stop-log",
    "pos.promo.quota",
    "pos.promo.report",
    "pos.promo.report-orders",
    "pos.report.missing-codes",
    "pos.gift-warehouse.get",
    "pos.customer.check",
    "pos.return.approval.create",
    "pos.return.approval.get",
    "pos.return.approval.approve",
    "pos.return.approval.reject",
    "pos.admin.return-approvals",
    "pos.channel.list",
    "pos.channel.create",
    "pos.channel.update",
    "pos.channel.stop",
    "pos.channel.resume",
    "pos.report.channels",
    "pos.report.customers",
    "pos.report.customer-detail"
  ],
  "ledger": {
    "submits": [
      {
        "docType": "sale",
        "contract": "bizcity_ledger_intake@1"
      },
      {
        "docType": "sale_return",
        "contract": "bizcity_ledger_intake@1"
      },
      {
        "docType": "manual_journal",
        "contract": "bizcity_ledger_intake@1"
      }
    ]
  },
  "ui": {
    "icon": "ShoppingCart",
    "color": "#0e7490",
    "order": 30
  },
  "events": {
    "emits": [
      {
        "type": "pos.order.recorded",
        "version": 1
      },
      {
        "type": "pos.return.recorded",
        "version": 1
      },
      {
        "type": "pos.order.cancelled",
        "version": 1
      }
    ],
    "subscribes": [
      {
        "type": "phieu-ban.doc.recorded",
        "version": 1
      },
      {
        "type": "phieu-ban.doc.cancelled",
        "version": 1
      }
    ]
  },
  "settings": [
    "bizcity.pos.return_days",
    "bizcity.pos.require_open_shift",
    "bizcity.pos.shift_scope",
    "bizcity.pos.cash_diff_alert",
    "bizcity.pos.cash_diff_journal",
    "bizcity.pos.cash_short_reason",
    "bizcity.pos.cash_over_reason",
    "bizcity.pos.return_bad_warehouses",
    "bizcity.pos.gift_warehouses",
    "bizcity.pos.return_days_by_shop"
  ]
}
