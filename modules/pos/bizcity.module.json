{
  "contract": "bizcity_module@1",
  "id": "bizcity.pos",
  "key": "pos",
  "kind": "module",
  "version": "0.1.0",
  "label": "Máy bán POS",
  "description": "Phía máy chủ của máy bán POS (hợp đồng /pos/*): khởi động màn bán, cấp số phiếu, nhận đơn bán tại quầy và nộp chứng từ sale vào sổ qua cửa nạp (kế hoạch module POS).",
  "owners": [
    "@hoanganh8389"
  ],
  "standard": "^1.0",
  "requires": {
    "capabilities": [
      "ledger.submit",
      "data.tenant-tx",
      "data.read-views",
      "data.migrations.module",
      "actions.runtime",
      "actions.idempotency",
      "evidence.receipt",
      "ledger.cancel",
      "events.outbox",
      "settings.registry"
    ]
  },
  "permissions": [
    {
      "key": "pos:sell",
      "label": "Bán hàng trên máy POS: khởi động màn bán, xin số phiếu, gửi đơn, xem / tra đơn, tìm khách",
      "risk": "low"
    },
    {
      "key": "pos:return",
      "label": "Trả hàng / đổi hàng trên máy POS (phiếu trả nối đơn gốc)",
      "risk": "low"
    },
    {
      "key": "pos:cancel",
      "label": "Huỷ đơn máy POS đang chờ thanh toán",
      "risk": "low"
    },
    {
      "key": "pos:report",
      "label": "Xem quản trị bán lẻ máy POS: đơn, phiếu trả, sổ ca, tổng quan, cài đặt bán hàng của mọi chi nhánh (kế toán, quản lý)",
      "risk": "low"
    }
  ],
  "data": {
    "schema": "mod_pos",
    "tables": [
      "orders",
      "order_lines",
      "returns",
      "return_lines",
      "code_counters",
      "shifts"
    ],
    "reads": [
      "bizcity_read.branches",
      "bizcity_read.products",
      "bizcity_read.tax_codes",
      "bizcity_read.payment_methods",
      "bizcity_read.partners",
      "bizcity_read.branch_prices",
      "bizcity_read.stock_on_hand"
    ]
  },
  "actions": [
    "pos.bootstrap.get",
    "pos.sequence.reserve",
    "pos.order.create",
    "pos.order.get",
    "pos.order.lookup",
    "pos.order.cancel",
    "pos.order.returnable",
    "pos.return.create",
    "pos.return.list",
    "pos.exchange.create",
    "pos.customer.search",
    "pos.customer.lookup",
    "pos.customer.orders",
    "pos.catalog.snapshot",
    "pos.catalog.search",
    "pos.catalog.barcode",
    "pos.stock.get",
    "pos.shift.current",
    "pos.shift.open",
    "pos.shift.close",
    "pos.report.orders",
    "pos.report.dashboard",
    "pos.admin.orders",
    "pos.admin.returns",
    "pos.admin.shifts",
    "pos.admin.dashboard",
    "pos.admin.settings",
    "pos.order.qr-confirm",
    "pos.order.qr-renew",
    "pos.order.invoice-buyer",
    "pos.stock.all"
  ],
  "ledger": {
    "submits": [
      {
        "docType": "sale",
        "contract": "bizcity_ledger_intake@1"
      },
      {
        "docType": "sale_return",
        "contract": "bizcity_ledger_intake@1"
      }
    ]
  },
  "ui": {
    "icon": "ShoppingCart",
    "color": "#0e7490",
    "order": 30
  },
  "events": {
    "emits": [
      {
        "type": "pos.order.recorded",
        "version": 1
      },
      {
        "type": "pos.return.recorded",
        "version": 1
      },
      {
        "type": "pos.order.cancelled",
        "version": 1
      }
    ]
  },
  "settings": [
    "bizcity.pos.return_days",
    "bizcity.pos.require_open_shift",
    "bizcity.pos.shift_scope",
    "bizcity.pos.cash_diff_alert"
  ]
}
