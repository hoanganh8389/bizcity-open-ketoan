{
  "name": "@bizcity-module/pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Máy bán POS — module Bizcity (bizcity_module@1), kế hoạch module POS (repo tgs_pos_react, docs/module-pos).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('api','dist/api',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root . test"
  },
  "dependencies": {
    "@bizcity/module-sdk": "1.0.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
