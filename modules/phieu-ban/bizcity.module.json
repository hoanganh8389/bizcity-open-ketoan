{
  "contract": "bizcity_module@1",
  "id": "bizcity.phieu-ban",
  "key": "phieu-ban",
  "kind": "module",
  "version": "0.5.1",
  "label": "Phiếu bán nhập tay",
  "description": "Phiếu bán / trả hàng do kế toán lập (BH10, BH11): nháp → duyệt nộp sổ (sale / sale_return) → bỏ duyệt đảo bút toán (NT-BH-015). Đơn đặt hàng BH20 (NT-BH-023): giữ hàng ở KCB; chuyến giao qua kho KHG, phí ship, COD, copy đơn (NT-BH-032).",
  "owners": ["@hoanganh8389"],
  "standard": "^1.0",
  "requires": {
    "capabilities": ["ledger.submit", "ledger.cancel", "data.tenant-tx", "data.read-views", "data.migrations.module", "actions.runtime", "actions.idempotency", "evidence.receipt", "events.outbox", "settings.registry", "actions.call", "documents.versions", "documents.links"]
  },
  "permissions": [
    { "key": "phieu-ban:read", "label": "Xem phiếu bán / trả hàng nhập tay", "roles": ["owner", "chief_accountant", "accountant", "viewer"], "risk": "low" },
    { "key": "phieu-ban:write", "label": "Lập, sửa, duyệt, bỏ duyệt phiếu bán / trả hàng nhập tay", "roles": ["owner", "chief_accountant", "accountant"], "risk": "low" },
    { "key": "phieu-ban:order-approve", "label": "Duyệt / từ chối đơn đặt hàng chờ duyệt (vượt hạn mức nợ, nợ quá hạn)", "roles": ["owner", "chief_accountant"], "risk": "high" },
    { "key": "phieu-ban:giao-hang-lap", "label": "Giao hàng đơn đặt hàng — lập chuyến giao (Chờ lấy hàng) (NT-BH-032)", "roles": ["owner", "chief_accountant", "accountant"], "risk": "low" },
    { "key": "phieu-ban:giao-hang-sua", "label": "Giao hàng đơn đặt hàng — cập nhật trạng thái chuyến: Đang giao (chuyển kho sang KHG), Đã giao (sinh phiếu bán nháp), Hoàn (NT-BH-032)", "roles": ["owner", "chief_accountant", "accountant"], "risk": "low" }
  ],
  "data": {
    "schema": "mod_phieu_ban",
    "tables": ["docs", "code_counters", "orders", "order_events", "order_shipments"],
    "reads": ["bizcity_read.branches", "bizcity_read.products", "bizcity_read.tax_codes", "bizcity_read.payment_methods", "bizcity_read.partners", "bizcity_read.branch_prices", "bizcity_read.stock_on_hand", "bizcity_read.warehouses", "bizcity_read.item_kinds"]
  },
  "actions": [
    "phieu-ban.doc.list",
    "phieu-ban.doc.get",
    "phieu-ban.doc.create",
    "phieu-ban.doc.update",
    "phieu-ban.doc.delete",
    "phieu-ban.doc.approve",
    "phieu-ban.doc.unapprove",
    "phieu-ban.doc.returnable",
    "phieu-ban.quote.get",
    "phieu-ban.order.list",
    "phieu-ban.order.get",
    "phieu-ban.order.history",
    "phieu-ban.order.settings",
    "phieu-ban.order.create",
    "phieu-ban.order.update",
    "phieu-ban.order.import",
    "phieu-ban.order.send",
    "phieu-ban.order.approve",
    "phieu-ban.order.reject",
    "phieu-ban.order.deliver",
    "phieu-ban.order.close",
    "phieu-ban.order.cancel",
    "phieu-ban.channel.summary",
    "phieu-ban.customer.docs",
    "phieu-ban.shipment.create",
    "phieu-ban.shipment.status",
    "phieu-ban.order.copy",
    "phieu-ban.voucher.check"
  ],
  "ledger": {
    "submits": [
      { "docType": "sale", "contract": "bizcity_ledger_intake@1" },
      { "docType": "sale_return", "contract": "bizcity_ledger_intake@1" },
      { "docType": "transfer", "contract": "bizcity_ledger_intake@1" }
    ]
  },
  "events": {
    "emits": [
      { "type": "phieu-ban.doc.recorded", "version": 1 },
      { "type": "phieu-ban.doc.cancelled", "version": 1 }
    ]
  },
  "ui": { "icon": "FileText", "color": "#0e7490", "order": 31 },
  "settings": ["bizcity.phieu_ban.block_negative_stock", "bizcity.phieu_ban.hold_warehouses", "bizcity.phieu_ban.ship_warehouses", "bizcity.phieu_ban.ship_fee_sku", "bizcity.phieu_ban.cod_methods"]
}
