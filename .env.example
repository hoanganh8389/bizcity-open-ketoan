# Sao chép thành .env rồi sửa. Không đưa .env lên git.

# Bắt buộc: khoá ký phiên đăng nhập (chuỗi ngẫu nhiên dài ≥ 32 ký tự)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Cơ sở dữ liệu
DB_PASSWORD=ketoan
DB_PORT=5434

# Cổng giao diện. Trên máy chủ thật đặt WEB_BIND=127.0.0.1 và cho người dùng đi qua reverse proxy có HTTPS.
WEB_BIND=0.0.0.0
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088

# Loại sổ: internal = sổ nội bộ (mặc định); tax = sổ thuế — chỉ kéo phiếu bán / hoàn có số hoá đơn điện tử
BOOK_MODE=internal
# Nhãn môi trường hiện thành dải trên đầu giao diện (bản test: ENV_LABEL=BẢN TEST); bản thật để trống
ENV_LABEL=

# Add-in bật: * = tất cả, hoặc danh sách mã: excel-export,spreadsheet-ai
ADDINS=*
# Địa chỉ ứng dụng Bảng tính AI (để trống nếu chưa có)
SPREADSHEET_AI_URL=

# Khởi tạo đơn vị đầu tiên
SEED_TENANT_CODE=demo
SEED_TENANT_NAME=Công ty Demo
SEED_ADMIN_EMAIL=admin@ketoan.local
SEED_ADMIN_PASSWORD=Admin@123
# Khoá API cố định cho hệ thống bán hàng gửi chứng từ (bỏ trống = sinh ngẫu nhiên, in ra log)
SEED_API_KEY=

# Đăng nhập bằng tài khoản hệ thống quản trị (WordPress multisite): khoá chung ký vé (giống hệt "Khoá đăng nhập bằng tài khoản WordPress"
# ở Cổng kế toán bên WordPress, >= 24 ký tự), mã đơn vị nhận người dùng, và địa chỉ cấp vé để mở thẳng phần mềm
# (vd https://quantri.ten-mien/wp-admin/admin-post.php?action=tgs_acc_sso_go). Trống = tắt.
WP_SSO_SECRET=
WP_SSO_TENANT=
WP_SSO_LOGIN_URL=
# Địa chỉ trang quản trị bán hàng (vd https://quantri.ten-mien/wp-admin/) — mở phiếu gốc (phiếu nhập kho…) ở tab mới.
# Trống = suy từ WP_SSO_LOGIN_URL. (WP_EMBED_URL cũ: không dùng nữa, phần mềm chạy độc lập.)
WP_ADMIN_URL=

# Tra cứu mã số thuế khi thêm đối tượng: khoá doanhnghiep.vn (tuỳ chọn, thêm người đại diện, ngành nghề).
# Trống = dùng nguồn công khai VietQR. TAX_LOOKUP=off: tắt hẳn, không gửi MST ra ngoài.
DOANHNGHIEP_API_KEY=
TAX_LOOKUP=on

# Đọc hoá đơn NCC bằng dịch vụ AI (Mua hàng → Hoá đơn → Quét): địa chỉ dịch vụ, khoá Bearer (tuỳ chọn), thời gian chờ (ms).
# Khuôn: POST { fileName, mime, dataBase64, hint } → { invoices: [...] }. Trống = chỉ nhập Excel / gõ tay.
# Bản Pro: trỏ về dịch vụ đọc hoá đơn của Bizcity Cell (docs/standard/CELL-CONNECT.md §5).
INVOICE_AI_URL=
INVOICE_AI_KEY=
INVOICE_AI_TIMEOUT_MS=120000
