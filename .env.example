# Sao chép thành .env rồi sửa. Không đưa .env lên git.

# Bắt buộc: khoá ký phiên đăng nhập (chuỗi ngẫu nhiên dài ≥ 32 ký tự)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Phiên đăng nhập hết hạn sau bao nhiêu giờ (mặc định 12).
# JWT_TTL_HOURS=12
# Địa chỉ API lắng nghe (mặc định 0.0.0.0 — mọi giao diện mạng; chỉ máy này: 127.0.0.1).
# HOST=0.0.0.0

# Cơ sở dữ liệu
DB_PASSWORD=ketoan
DB_PORT=5434
# Vai trò CSDL riêng cho API, không superuser (R-SEC-6, migration 0032). Bản thật nên bật: đặt cả hai dòng dưới.
# Mật khẩu ≥ 16 ký tự, chỉ chữ và số (nằm trong URL kết nối) — vd: openssl rand -hex 24. Trống = API dùng vai trò sở hữu như cũ.
# DB_APP_USER=ketoan_app
# Test / CI: kết nối bằng vai trò sở hữu nhưng chuyển sang ketoan_app (SET ROLE) để RLS có hiệu lực — superuser luôn vượt RLS.
# DB_SET_ROLE=ketoan_app
# DB_APP_PASSWORD=

# Cổng giao diện. Trên máy chủ thật đặt WEB_BIND=127.0.0.1 và cho người dùng đi qua reverse proxy có HTTPS.
WEB_BIND=0.0.0.0
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088

# Loại sổ: internal = sổ nội bộ (mặc định); tax = sổ thuế — chỉ kéo phiếu bán / hoàn có số hoá đơn điện tử
BOOK_MODE=internal
# Nhãn môi trường hiện thành dải trên đầu giao diện (bản test: ENV_LABEL=BẢN TEST); bản thật để trống
ENV_LABEL=
# Số đo Prometheus GET /metrics (docs/ops/OBSERVABILITY.md). Đặt chuỗi ngẫu nhiên dài khi cổng API mở ra ngoài máy chủ;
# Prometheus trong infrastructure/monitoring/ gửi kèm token này. Trống = chỉ trong mạng nội bộ Docker.
METRICS_TOKEN=
# Bộ giám sát (infrastructure/monitoring, tuỳ chọn) — scripts/cai-nhanh.sh --giam-sat tự sinh ba dòng đầu.
# GRAFANA_ADMIN_PASSWORD=          # BẮT BUỘC khi bật giám sát
# PG_EXPORTER_USER=ketoan_monitor  # vai trò chỉ đọc thống kê, job db-migrate tự tạo khi có mật khẩu
# PG_EXPORTER_PASSWORD=            # ≥ 16 ký tự, chỉ chữ và số
# LOKI_LABELDROP=tenant            # bản cài hàng trăm+ đơn vị: bỏ nhãn tenant khỏi Loki
# Truy vết OpenTelemetry (ADR-0010). Trống = vẫn có traceId trong log / phản hồi lỗi / bằng chứng, không gửi trace đi đâu.
# Bật bộ giám sát thì compose giám sát tự đặt endpoint = Collector nội bộ. OTEL_SDK_DISABLED=true tắt hẳn.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_DISABLED=
# OTEL_SERVICE_NAME=bizcity-core-api
# [2026-11-01 10:40 PM Johnny Chu - Chu Hoàng Anh] PHASE-019 — W2: Bàn điều tra cho nhà phát triển (API trung gian chỉ đọc, lọc theo đơn vị).
# Địa chỉ nội bộ API gọi tới; bật bộ giám sát thì compose giám sát tự đặt các URL. Trống = nguồn đó "chưa bật".
# DEVTOOLS_TEMPO_URL=http://tempo:3200
# DEVTOOLS_LOKI_URL=http://loki:3100
# DEVTOOLS_PROMETHEUS_URL=http://prometheus:9090
# DEVTOOLS_ALERTMANAGER_URL=http://alertmanager:9093
# DEVTOOLS_GRAFANA_URL=http://127.0.0.1:3000   # chỉ dựng link ở chế độ Vận hành
# DEVTOOLS_OPS=true                           # chế độ Vận hành: CHỈ có tác dụng khi bản cài có đúng một đơn vị
# Trang báo lỗi: có thì khay Mã tra cứu thêm nút mở (vd https://github.com/<tổ chức>/<repo>/issues/new?template=bao-loi.yml)
# BUG_REPORT_URL=

# Add-in bật: * = tất cả, hoặc danh sách mã: excel-export,spreadsheet-ai
ADDINS=*
# Địa chỉ ứng dụng Bảng tính AI (để trống nếu chưa có)
SPREADSHEET_AI_URL=

# Khởi tạo đơn vị đầu tiên
SEED_TENANT_CODE=demo
SEED_TENANT_NAME=Công ty Demo
SEED_ADMIN_EMAIL=admin@ketoan.local
SEED_ADMIN_PASSWORD=Admin@123
# Khoá API cố định cho hệ thống bán hàng gửi chứng từ (bỏ trống = sinh ngẫu nhiên, in ra log)
SEED_API_KEY=

# Đăng nhập bằng tài khoản hệ thống quản trị (WordPress multisite): khoá chung ký vé (giống hệt "Khoá đăng nhập bằng tài khoản WordPress"
# ở Cổng kế toán bên WordPress, >= 24 ký tự), mã đơn vị nhận người dùng, và địa chỉ cấp vé để mở thẳng phần mềm
# (vd https://quantri.ten-mien/wp-admin/admin-post.php?action=tgs_acc_sso_go). Trống = tắt.
WP_SSO_SECRET=
WP_SSO_TENANT=
WP_SSO_LOGIN_URL=
# Địa chỉ trang quản trị bán hàng (vd https://quantri.ten-mien/wp-admin/) — mở phiếu gốc (phiếu nhập kho…) ở tab mới.
# Trống = suy từ WP_SSO_LOGIN_URL. (WP_EMBED_URL cũ: không dùng nữa, phần mềm chạy độc lập.)
WP_ADMIN_URL=

# Tra cứu mã số thuế khi thêm đối tượng: khoá doanhnghiep.vn (tuỳ chọn, thêm người đại diện, ngành nghề).
# Trống = dùng nguồn công khai VietQR. TAX_LOOKUP=off: tắt hẳn, không gửi MST ra ngoài.
DOANHNGHIEP_API_KEY=
TAX_LOOKUP=on

# Đọc hoá đơn NCC bằng dịch vụ AI (Mua hàng → Hoá đơn → Quét): địa chỉ dịch vụ, khoá Bearer (tuỳ chọn), thời gian chờ (ms).
# Khuôn: POST { fileName, mime, dataBase64, hint } → { invoices: [...] }. Trống = chỉ nhập Excel / gõ tay.
# Bản Pro: trỏ về dịch vụ đọc hoá đơn của Bizcity Cell (docs/standard/CELL-CONNECT.md §5).
INVOICE_AI_URL=
INVOICE_AI_KEY=
INVOICE_AI_TIMEOUT_MS=120000
