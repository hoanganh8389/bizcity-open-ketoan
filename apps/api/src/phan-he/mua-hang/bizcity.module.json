{
  "contract": "bizcity_module@1",
  "id": "bizcity.mua-hang",
  "key": "mua-hang",
  "kind": "module",
  "version": "0.1.0",
  "label": "Mua hàng",
  "description": "Nhà cung cấp, mua hàng, trả hàng nhà cung cấp, công nợ phải trả",
  "owners": [
    "@Thuy2k",
    "@hoanganh8389"
  ],
  "standard": "^1.0",
  "requires": {
    "capabilities": [
      "ledger.submit",
      "masterdata.read",
      "masterdata.write",
      "documents.numbering",
      "documents.attachments",
      "documents.workflow"
    ]
  },
  "permissions": [
    {
      "key": "mua-hang:phieu-mua-xem",
      "label": "Xem phiếu mua hàng",
      "risk": "low"
    },
    {
      "key": "mua-hang:phieu-mua-lap",
      "label": "Lập / sửa phiếu mua hàng (cửa nạp chứng từ)",
      "risk": "low"
    },
    {
      "key": "mua-hang:phieu-mua-huy",
      "label": "Huỷ phiếu mua hàng",
      "risk": "low"
    },
    {
      "key": "mua-hang:tra-ncc-xem",
      "label": "Xem phiếu trả hàng nhà cung cấp",
      "risk": "low"
    },
    {
      "key": "mua-hang:tra-ncc-lap",
      "label": "Lập / sửa phiếu trả hàng nhà cung cấp (cửa nạp chứng từ)",
      "risk": "low"
    },
    {
      "key": "mua-hang:tra-ncc-huy",
      "label": "Huỷ phiếu trả hàng nhà cung cấp",
      "risk": "low"
    }
  ],
  "data": {
    "tables": [
      "purchase_documents",
      "purchase_policies",
      "purchase_attachments",
      "supplier_products",
      "supplier_invoices",
      "supplier_invoice_lines",
      "supplier_item_aliases",
      "stock_levels",
      "stock_sku_settings",
      "stock_max_requests",
      "order_formulas",
      "transfer_requests"
    ]
  },
  "documents": [
    {
      "type": "mua-hang.purchase-document",
      "label": "Phiếu mua hàng",
      "workflow": "apps/api/src/phan-he/mua-hang/purchase-document.workflow.yaml"
    }
  ],
  "ledger": {
    "submits": [
      {
        "docType": "purchase",
        "contract": "bizcity_ledger_intake@1"
      },
      {
        "docType": "purchase_return",
        "contract": "bizcity_ledger_intake@1"
      },
      {
        "docType": "stock_adjustment",
        "contract": "bizcity_ledger_intake@1"
      }
    ]
  },
  "settings": [
    "bizcity.mua_hang.settings"
  ],
  "actions": [
    "mua-hang.purchase.document-upsert",
    "mua-hang.purchase.analyze",
    "mua-hang.purchase.documents-submit",
    "mua-hang.purchase.documents-approve",
    "mua-hang.purchase.documents-override",
    "mua-hang.purchase.documents-review-outside",
    "mua-hang.purchase.documents-cancel",
    "mua-hang.purchase.products-lookup",
    "mua-hang.purchase.attachment-delete",
    "mua-hang.purchase.policy-delete",
    "mua-hang.purchase.supplier-products",
    "mua-hang.purchase.supplier-product-delete",
    "mua-hang.purchase.settings",
    "mua-hang.purchase.variants",
    "mua-hang.invoice.create",
    "mua-hang.invoice.update",
    "mua-hang.invoice.cancel",
    "mua-hang.invoice.prepare",
    "mua-hang.invoice.import",
    "mua-hang.invoice-alias.delete",
    "mua-hang.purchase.document-create",
    "mua-hang.policy.transfer-limit",
    "mua-hang.rebate.preview",
    "mua-hang.unit.lookup",
    "mua-hang.unit.thung-preview",
    "mua-hang.unit.thung-apply",
    "mua-hang.stock.hierarchy",
    "mua-hang.stock.hierarchy-auto",
    "mua-hang.stock.levels",
    "mua-hang.stock.sku-settings",
    "mua-hang.stock-formula.save",
    "mua-hang.transfer-request.create",
    "mua-hang.max-request.create",
    "mua-hang.max-request.update",
    "mua-hang.max-request.approve",
    "mua-hang.max-request.cancel",
    "mua-hang.stock.init-prices-preview",
    "mua-hang.stock.init-prices-import",
    "mua-hang.stock.init-reconcile-preview",
    "mua-hang.stock.init-reconcile-import",
    "mua-hang.stock.init-max-preview",
    "mua-hang.stock.init-max-import",
    "mua-hang.purchase.documents-unapprove",
    "mua-hang.invoice.scan", "mua-hang.invoice.ingest-xml",
    "mua-hang.sku-info.lookup",
    "mua-hang.unit.thung-empty-rows-delete",
    "mua-hang.transfer-request.done",
    "mua-hang.transfer-request.cancel",
    "mua-hang.transfer-request.reopen",
    "mua-hang.attachment.add",
    "mua-hang.policy.create",
    "mua-hang.policy.update"
  ],
  "ui": {
    "icon": "Truck",
    "color": "#e8710a",
    "order": 30
  },
  "waivers": [
    {
      "rule": "STD-MOD-2",
      "reason": "Phân hệ còn ghi thẳng bảng danh mục / cấu hình của lõi (audit A-17, nợ SC-MOD-2 trong baseline); chuyển sang action / service danh mục ở PHASES 3.9",
      "adr": "ADR-0005",
      "expires": "2027-03-31"
    }
  ]
}
