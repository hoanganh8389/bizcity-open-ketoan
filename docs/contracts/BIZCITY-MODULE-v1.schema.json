{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_module/1.1.0",
  "title": "bizcity_module@1",
  "description": "Manifest module / add-in theo Bizcity Framework Standard v1 (docs/contracts/BIZCITY-MODULE-v1.md).",
  "type": "object",
  "required": ["contract", "id", "key", "kind", "version", "label", "description", "owners", "standard", "requires"],
  "properties": {
    "contract": { "const": "bizcity_module@1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]{1,31}$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "kind": { "enum": ["module", "addin"] },
    "version": { "$ref": "#/$defs/semver" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^@[A-Za-z0-9_/-]+$" } },
    "standard": { "type": "string", "pattern": "^[\\^~>=<]*\\d+(\\.\\d+){0,2}" },
    "requires": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" } },
        "modules": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]{1,31}$" }, "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "roles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z_]*$" } },
          "risk": { "enum": ["low", "high"] }
        },
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "pattern": "^mod_[a-z][a-z0-9_]*$" },
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "not": { "pattern": "^(ledger_|accounting_event|posting_|document_sequences|tax_invoice|inventory_|debt_|audit_logs|evidence_|event_outbox|tenants$|users$|api_keys$)" }
          }
        },
        "reads": { "type": "array", "items": { "type": "string", "pattern": "^bizcity_read\\.[a-z][a-z0-9_]*$" } }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "label"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
          "label": { "type": "string" },
          "numbering": { "type": "object", "properties": { "series": { "type": "string" }, "pattern": { "type": "string" } }, "required": ["series"], "additionalProperties": false },
          "workflow": { "type": "string" },
          "ledger": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["on", "docType"],
              "properties": { "on": { "type": "string" }, "docType": { "type": "string", "pattern": "^[a-z][a-z_]*$" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$" } },
    "events": {
      "type": "object",
      "properties": {
        "emits": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } },
        "subscribes": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "submits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["docType", "contract"],
            "properties": {
              "docType": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
              "contract": { "type": "string", "pattern": "^bizcity_ledger_intake@\\d+$" },
              "reasonCodes": { "type": "array", "items": { "type": "string" } },
              "reasons": {
                "type": "object",
                "description": "Lý do định khoản docType này cần (BIZCITY-POSTING-TEMPLATE §7): Core kiểm đơn vị đã có lý do mặc định trước khi cài module",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["in", "out", "receipt", "payment"] },
                  "default": { "type": "string", "pattern": "^[a-z_]+(:[a-z_]+)?$", "description": "Khoá lý do mặc định (flags.default), mặc định = docType" },
                  "suggestedPacks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+\\.[a-z0-9-]+(@\\^?\\d+(\\.\\d+){0,2})?$" } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "settings": { "type": "array", "items": { "type": "string", "pattern": "^bizcity\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$" } },
    "extensions": {
      "type": "object",
      "properties": {
        "menu": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "path": { "type": "string" }, "code": { "type": "string" }, "parent": { "type": "string" }, "permission": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "component"],
            "properties": { "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }, "component": { "type": "string" }, "permission": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hook", "handler"],
            "properties": { "hook": { "type": "string" }, "handler": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "print": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": { "icon": { "type": "string" }, "color": { "type": "string" }, "order": { "type": "integer" } },
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "reason", "adr"],
        "properties": {
          "rule": { "type": "string", "pattern": "^(STD|CONF)-[A-Z]+-\\d+$" },
          "reason": { "type": "string", "minLength": 10 },
          "adr": { "type": "string" },
          "expires": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "addin" } } },
      "then": { "not": { "anyOf": [{ "required": ["data"] }, { "required": ["documents"] }] } }
    }
  ],
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "eventRef": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,4}$" },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
