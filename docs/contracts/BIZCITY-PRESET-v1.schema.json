{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schemas/bizcity_preset@1.json",
  "title": "bizcity_preset@1",
  "description": "Gói cài nhanh theo ngành: phân hệ bật, gói định khoản, cấu hình, dữ liệu mẫu hư cấu nạp qua API (BIZCITY-PRESET-v1.md).",
  "type": "object",
  "required": ["contract", "id", "version", "title", "description", "industries", "requires", "modules", "sample"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "bizcity_preset@1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$", "description": "Trùng tên thư mục presets/<id>/" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "industries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "regime": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Chế độ kế toán, vd vn-tt99" },
    "requires": {
      "type": "object",
      "required": ["standard", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "standard": { "type": "string", "description": "Dải phiên bản Standard, vd ^1.0" },
        "capabilities": { "type": "array", "items": { "type": "string" }, "description": "Năng lực Core cần (bizcity-standard.json), phải available" }
      }
    },
    "modules": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "Giá trị ENABLED_MODULES đề xuất" },
    "postingPack": {
      "type": "object",
      "required": ["id", "file"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string", "description": "Đường dẫn tương đối từ preset.json tới gói bizcity_posting_template@1" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postingModes": { "type": "object", "additionalProperties": { "enum": ["auto", "approve"] }, "description": "PUT /api/v1/settings/posting-modes" }
      }
    },
    "sample": {
      "type": "object",
      "required": ["fictional"],
      "additionalProperties": false,
      "properties": {
        "fictional": { "const": true, "description": "Dữ liệu mẫu phải là hư cấu: repo công khai (R-SEC-10)" },
        "branches": { "type": "string", "description": "Tệp JSON: mảng branchCreate (POST /api/v1/branches)" },
        "partners": { "type": "string", "description": "Tệp JSON: mảng { code, … } (PUT /api/v1/partners/:code)" },
        "products": { "type": "string", "description": "Tệp JSON: mảng { sku, … } (PUT /api/v1/catalog/products/:sku)" },
        "documents": { "type": "string", "description": "Tệp JSON: mảng chứng từ bizcity_ledger_intake@1 (POST /api/v1/documents), docKey bắt đầu bằng preset:<id>:" }
      }
    }
  }
}
