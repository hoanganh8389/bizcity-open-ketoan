{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/contracts/bizcity_ledger_intake/1.0.0",
  "title": "bizcity_ledger_intake@1",
  "description": "Sự việc gửi vào sổ BizCity Ledger. Viết tay theo packages/contracts/src/documents.ts (ingestDocumentSchema); khi lệch, zod thắng. Trường lạ được bỏ qua.",
  "oneOf": [
    { "$ref": "#/$defs/sale" },
    { "$ref": "#/$defs/sale_return" },
    { "$ref": "#/$defs/purchase" },
    { "$ref": "#/$defs/purchase_return" },
    { "$ref": "#/$defs/transfer" },
    { "$ref": "#/$defs/stock_adjustment" },
    { "$ref": "#/$defs/cash_transfer" },
    { "$ref": "#/$defs/customer_payment" },
    { "$ref": "#/$defs/supplier_payment" }
  ],
  "$defs": {
    "money": { "type": "number" },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.]+(Z|[+-]\\d{2}:?\\d{2})?)?$"
    },
    "code32": { "type": "string", "minLength": 1, "maxLength": 32 },
    "docKey": { "type": "string", "minLength": 3, "maxLength": 160 },

    "base": {
      "type": "object",
      "required": ["docType", "docKey", "branchCode", "docNo", "docDate"],
      "properties": {
        "docKey": { "$ref": "#/$defs/docKey" },
        "version": { "type": "integer", "minimum": 1, "default": 1 },
        "branchCode": { "$ref": "#/$defs/code32" },
        "docNo": { "type": "string", "minLength": 1, "maxLength": 64 },
        "docDate": { "$ref": "#/$defs/date" },
        "reasonCode": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 1000, "default": "" },
        "internalOnly": { "type": "boolean", "default": false },
        "partner": { "$ref": "#/$defs/partner" },
        "employee": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "name": { "type": "string", "maxLength": 255 }
          }
        },
        "invoice": { "$ref": "#/$defs/invoice" },
        "dueDate": { "$ref": "#/$defs/date" },
        "sourceSystem": { "type": "string", "maxLength": 32, "default": "external" },
        "sourceRef": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "type": "string", "maxLength": 64 },
            "id": { "type": "string", "maxLength": 64 },
            "label": { "type": "string", "maxLength": 120 },
            "url": { "type": "string", "maxLength": 500 }
          }
        },
        "extra": { "type": "object" }
      }
    },

    "partner": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "maxLength": 255 },
        "taxCode": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 500 },
        "email": { "type": "string", "maxLength": 255 },
        "phone": { "type": "string", "maxLength": 32 }
      }
    },

    "invoice": {
      "type": "object",
      "required": ["no", "date"],
      "properties": {
        "no": { "type": "string", "minLength": 1, "maxLength": 32 },
        "serial": { "type": "string", "maxLength": 32 },
        "form": { "type": "string", "maxLength": 32 },
        "date": { "$ref": "#/$defs/date" },
        "status": { "enum": ["valid", "replaced", "adjusted", "cancelled"], "default": "valid" },
        "provider": { "type": "string", "maxLength": 32 },
        "lookupCode": { "type": "string", "maxLength": 128 },
        "relatedInvoiceNo": { "type": "string", "maxLength": 32 },
        "relation": { "enum": ["replaces", "adjusts"] },
        "buyerName": { "type": "string", "maxLength": 255 },
        "buyerLegalName": { "type": "string", "maxLength": 255 },
        "buyerTaxCode": { "type": "string", "maxLength": 32 },
        "buyerAddress": { "type": "string", "maxLength": 500 }
      }
    },

    "tradeLine": {
      "type": "object",
      "required": ["lineKey", "amountBeforeTax", "taxCode"],
      "properties": {
        "lineKey": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sku": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 500 },
        "unit": { "type": "string", "maxLength": 32 },
        "qty": { "type": "number", "default": 0 },
        "unitQty": { "type": "number" },
        "unitRatio": { "type": "number", "exclusiveMinimum": 0 },
        "unitPrice": { "$ref": "#/$defs/money" },
        "amountBeforeTax": { "$ref": "#/$defs/money" },
        "discount": { "$ref": "#/$defs/money" },
        "taxCode": { "type": "string", "minLength": 1, "maxLength": 16 },
        "taxAmount": { "$ref": "#/$defs/money" },
        "warehouseCode": { "type": "string", "maxLength": 64 },
        "isGift": { "type": "boolean", "default": false },
        "excludeFromCost": { "type": "boolean" },
        "lotNo": { "type": "string", "maxLength": 64 },
        "expDate": { "$ref": "#/$defs/date" },
        "note": { "type": "string", "maxLength": 500 },
        "cost": { "$ref": "#/$defs/money" }
      }
    },

    "stockLine": {
      "type": "object",
      "required": ["lineKey", "sku", "qty"],
      "properties": {
        "lineKey": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "maxLength": 500 },
        "unit": { "type": "string", "maxLength": 32 },
        "qty": { "type": "number" },
        "amount": { "$ref": "#/$defs/money", "default": 0 },
        "warehouseCode": { "type": "string", "maxLength": 64 }
      }
    },

    "payment": {
      "type": "object",
      "required": ["methodCode", "amount"],
      "properties": {
        "methodCode": { "$ref": "#/$defs/code32" },
        "amount": { "$ref": "#/$defs/money" },
        "reference": { "type": "string", "maxLength": 255 },
        "paidAt": { "$ref": "#/$defs/date" }
      }
    },

    "allocation": {
      "type": "object",
      "required": ["lineKey", "amount"],
      "properties": {
        "lineKey": { "type": "string", "minLength": 1, "maxLength": 64 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "branchCode": { "type": "string", "maxLength": 32 },
        "invoiceDocKey": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },

    "tradeTotals": {
      "type": "object",
      "required": ["beforeTax", "tax", "total"],
      "properties": {
        "beforeTax": { "$ref": "#/$defs/money" },
        "tax": { "$ref": "#/$defs/money" },
        "total": { "$ref": "#/$defs/money" }
      }
    },
    "stockTotals": {
      "type": "object",
      "required": ["total"],
      "properties": { "total": { "$ref": "#/$defs/money" } }
    },
    "positiveTotals": {
      "type": "object",
      "required": ["total"],
      "properties": { "total": { "type": "number", "exclusiveMinimum": 0 } }
    },

    "sale": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["lines", "totals"],
      "properties": {
        "docType": { "const": "sale" },
        "lines": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/tradeLine" } },
        "payments": { "type": "array", "items": { "$ref": "#/$defs/payment" } },
        "offsets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["docKey", "amount"],
            "properties": {
              "docKey": { "$ref": "#/$defs/docKey" },
              "amount": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "totals": { "$ref": "#/$defs/tradeTotals" }
      }
    },
    "sale_return": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["lines", "totals"],
      "properties": {
        "docType": { "const": "sale_return" },
        "originalDocKey": { "type": "string", "maxLength": 160 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/tradeLine" } },
        "payments": { "type": "array", "items": { "$ref": "#/$defs/payment" } },
        "totals": { "$ref": "#/$defs/tradeTotals" }
      }
    },
    "purchase": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["lines", "totals"],
      "properties": {
        "docType": { "const": "purchase" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/tradeLine" } },
        "payments": { "type": "array", "items": { "$ref": "#/$defs/payment" } },
        "totals": { "$ref": "#/$defs/tradeTotals" }
      }
    },
    "purchase_return": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["lines", "totals"],
      "properties": {
        "docType": { "const": "purchase_return" },
        "originalDocKey": { "type": "string", "maxLength": 160 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/tradeLine" } },
        "payments": { "type": "array", "items": { "$ref": "#/$defs/payment" } },
        "totals": { "$ref": "#/$defs/tradeTotals" }
      }
    },
    "transfer": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["lines", "totals"],
      "properties": {
        "docType": { "const": "transfer" },
        "leg": { "enum": ["out", "in"] },
        "toBranchCode": { "$ref": "#/$defs/code32" },
        "fromBranchCode": { "$ref": "#/$defs/code32" },
        "status": { "enum": ["shipped", "received"], "default": "received" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/stockLine" } },
        "totals": { "$ref": "#/$defs/stockTotals" }
      }
    },
    "stock_adjustment": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["direction", "lines", "totals"],
      "properties": {
        "docType": { "const": "stock_adjustment" },
        "direction": { "enum": ["increase", "decrease", "mixed"] },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/stockLine" } },
        "totals": { "$ref": "#/$defs/stockTotals" }
      }
    },
    "cash_transfer": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["toBranchCode", "totals"],
      "properties": {
        "docType": { "const": "cash_transfer" },
        "toBranchCode": { "$ref": "#/$defs/code32" },
        "fromMethodCode": { "$ref": "#/$defs/code32", "default": "TM" },
        "toMethodCode": { "$ref": "#/$defs/code32", "default": "TM" },
        "fromBankCode": { "type": "string", "maxLength": 32 },
        "toBankCode": { "type": "string", "maxLength": 32 },
        "toReasonCode": { "type": "string", "maxLength": 32 },
        "status": { "enum": ["sent", "received"], "default": "received" },
        "totals": { "$ref": "#/$defs/positiveTotals" }
      }
    },
    "customer_payment": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["methodCode", "totals"],
      "properties": {
        "docType": { "const": "customer_payment" },
        "methodCode": { "$ref": "#/$defs/code32" },
        "direction": { "enum": ["in", "out"] },
        "lines": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/allocation" } },
        "totals": { "$ref": "#/$defs/positiveTotals" }
      }
    },
    "supplier_payment": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["methodCode", "totals"],
      "properties": {
        "docType": { "const": "supplier_payment" },
        "methodCode": { "$ref": "#/$defs/code32" },
        "direction": { "enum": ["in", "out"] },
        "lines": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/allocation" } },
        "totals": { "$ref": "#/$defs/positiveTotals" }
      }
    }
  }
}
